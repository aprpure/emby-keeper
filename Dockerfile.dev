# Dev image: dependency layer stays cached; source is editable and can be
# bind-mounted to /src at runtime (see scripts/docker-entrypoint-dev.sh).
ARG PYTHON_IMAGE=python:3.11-bookworm

FROM ${PYTHON_IMAGE}

WORKDIR /build

ENV VIRTUAL_ENV=/opt/venv
ENV PATH="${VIRTUAL_ENV}/bin:${PATH}"
ENV TZ="Asia/Shanghai"
ENV EK_IN_DOCKER="1"

RUN python -m venv "${VIRTUAL_ENV}" \
    && pip install --no-cache-dir -U pip setuptools wheel

# Dependency layer — only rebuilds when requirements.txt changes.
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# App / editable-install layer — rebuilds on source changes only.
COPY pyproject.toml MANIFEST.in README.md LICENSE ./
COPY embykeeper ./embykeeper
COPY embykeeperweb ./embykeeperweb
COPY embykeeperapi ./embykeeperapi
COPY scripts ./scripts

RUN pip install --no-cache-dir --no-deps -e . \
    && ln -s /build/scripts/docker-entrypoint-dev.sh /entrypoint.sh \
    && chmod +x /entrypoint.sh /build/scripts/docker-entrypoint-dev.sh \
    && mkdir -p /app \
    && touch /app/config.toml

WORKDIR /app

ENTRYPOINT ["/entrypoint.sh"]
